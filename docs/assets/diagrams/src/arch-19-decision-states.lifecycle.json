{
  "schema_version": 2,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Decision Register States",
    "output": "docs/assets/diagrams/arch-19-decision-states.html",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "waiting": { "label": "Open Decision" },
        "active": { "label": "Partially Resolved" },
        "success": { "label": "Resolved Decision" }
      }
    }
  },
  "lanes": [
    { "id": "main", "label": "Decision Status" },
    { "id": "terminal", "label": "Closed Status" }
  ],
  "states": [
    {
      "id": "open",
      "type": "waiting",
      "label": "Open",
      "sublabel": "owner or evidence needed",
      "lane": "main",
      "col": 0
    },
    {
      "id": "partial",
      "type": "active",
      "label": "Partially Resolved",
      "sublabel": "remaining question tracked",
      "lane": "main",
      "col": 1
    },
    {
      "id": "resolved",
      "type": "success",
      "label": "Resolved",
      "sublabel": "row retained, struck through",
      "lane": "terminal",
      "col": 2
    }
  ],
  "transitions": [
    { "from": "open", "to": "partial", "label": "partial decision" },
    { "from": "partial", "to": "resolved", "label": "remaining question closed" },
    { "from": "open", "to": "resolved", "label": "decision or evidence complete" }
  ],
  "cards": [
    {
      "dot": "slate",
      "title": "Register Rule",
      "items": [
        "Resolved rows stay in place because other sections cite their row numbers.",
        "An open row names the evidence or owner decision that would unblock it."
      ]
    }
  ]
}
