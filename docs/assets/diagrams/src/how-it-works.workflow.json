    },
    {
      "id": "rehydrate",
      "lane": "api",
      "col": 5,
      "type": "security",
      "label": "Re-hydrate",
      "sublabel": "tokens back to names",
      "width": 140
    },
    {
      "id": "review",
      "lane": "doctor",
      "col": 5,
      "type": "frontend",
      "label": "Review And Approve",
      "sublabel": "approval locks the note",
      "width": 140
    }
  ],
  "edges": [
    {
      "id": "capture-transcript",
      "from": "capture",
      "to": "transcript",
      "label": "save",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "transcript-deid",
      "from": "transcript",
      "to": "deid"
    },
    {
      "id": "transcript-rules",
      "from": "transcript",
      "to": "rules",
      "label": "raw text",
      "role": "branch",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "deid-llm",
      "from": "deid",
      "to": "llm",
      "label": "tokens"
    },
    {
      "id": "llm-model",
      "from": "llm",
      "to": "model",
      "label": "de-identified",
      "variant": "security"
    },
    {
      "id": "model-evidence",
      "from": "model",
      "to": "evidence",
      "label": "JSON",
      "variant": "dashed"
    },
    {
      "id": "evidence-union",
      "from": "evidence",
      "to": "union"
    },
    {
      "id": "rules-union",
      "from": "rules",
      "to": "union",
      "label": "rule hits",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "bottom"
    },
    {
      "id": "union-rehydrate",
      "from": "union",
      "to": "rehydrate"
    },
    {
      "id": "rehydrate-review",
      "from": "rehydrate",
      "to": "review"
    }
  ]
}
