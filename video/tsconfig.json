{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"]
  },
  "include": ["src/**/*", "scripts/**/*.ts", "record/**/*.ts", "sound/**/*.ts", "stand-in/**/*.ts"]
}
